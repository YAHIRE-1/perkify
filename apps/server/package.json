{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "varlock run -- bun run --hot src/index.ts",
    "start": "varlock run -- node dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@perkify/api": "workspace:*",
    "@perkify/auth": "workspace:*",
    "@perkify/db": "workspace:*",
    "better-auth": "catalog:",
    "evlog": "^2.28.1",
    "hono": "^4.13.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@perkify/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
