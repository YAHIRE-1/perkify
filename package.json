{
  "name": "perkify-full",
  "version": "1.0.0",
  "private": true,
  "type": "module",
"scripts": {
    "dev": "turbo run dev",
    "start": "pnpm --filter server start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker compose up -d",
    "db:delete": "docker compose down -v",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @perkify/db db:generate",
    "db:push": "pnpm --filter @perkify/db db:push",
    "db:migrate": "pnpm --filter @perkify/db db:migrate",
    "db:seed": "turbo run db:seed --filter=@perkify/db",
    "db:studio": "pnpm --filter @perkify/db db:studio",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/ && varlock codegen --path ./packages/auth/ && varlock codegen --path ./packages/contracts/",
    "typecheck": "turbo run typecheck",

    "contracts:build": "pnpm --filter @perkify/contracts build",
    "contracts:abi": "pnpm --filter @perkify/contracts build:abi",
    "contracts:test": "pnpm --filter @perkify/contracts test",
    "contracts:gas": "pnpm --filter @perkify/contracts test:gas",
    "contracts:deploy:local": "pnpm --filter @perkify/contracts deploy:local",
    "contracts:deploy:sepolia": "pnpm --filter @perkify/contracts deploy:sepolia",
    "contracts:deploy:eth-sepolia": "pnpm --filter @perkify/contracts deploy:eth-sepolia",
    "contracts:deploy:mainnet": "pnpm --filter @perkify/contracts deploy:mainnet"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "@types/bun": "catalog:",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2",
    "varlock": "catalog:"
  },
  "license": "ISC",
  "dependencies": {
    "@varlock/nextjs-integration": "^1.2.5"
  }
}