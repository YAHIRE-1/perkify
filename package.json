{
  "name": "perkify-full",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "start": "pnpm --filter server start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @perkify/db db:generate",
    "db:push": "pnpm --filter @perkify/db db:push",
    "db:studio": "pnpm --filter @perkify/db db:studio",
    "typecheck": "turbo run typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "@types/bun": "catalog:",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2",
    "varlock": "catalog:"
  },
  "license": "ISC"
}