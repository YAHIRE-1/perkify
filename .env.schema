# @defaultSensitive=false
# ---

# Entorno de ejecución
# @type=enum(development, test, production)
NODE_ENV=development

# Conexión a Postgres (el valor real va en .env.local)
# @type=url(allowedProtocols=[postgresql])
DATABASE_URL=

# Secreto de Better Auth (el valor real va en .env.local)
# @required @sensitive @type=string(minLength=32)
BETTER_AUTH_SECRET=

# URL pública del servidor de auth/API
# @required @type=url
BETTER_AUTH_URL=http://localhost:3002

# Origen permitido por CORS (el frontend)
# @required @type=url
CORS_ORIGIN=http://localhost:3001

# Puerto del API
# @required @type=port
PORT=3002

# URL del API usada en el servidor
# @public @type=url
NEXT_PUBLIC_PERKIFY_API_URL=${BETTER_AUTH_URL}

# URL del frontend (origen confiable para Better Auth)
# @required @type=url
WEB_URL=${CORS_ORIGIN}

# Dominio para Sign-In With Ethereum (solo el host, sin protocolo)
# @required @type=string
SIWE_DOMAIN=localhost:3001

# ---------------------------------------------------------------
# Contratos (@perkify/contracts) — solo se usan al compilar/desplegar
# ---------------------------------------------------------------

# RPC de Arbitrum Sepolia (testnet)
# @type=url(allowedProtocols=[https])
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# RPC de Arbitrum One (mainnet)
# @type=url(allowedProtocols=[https])
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Llave privada de la wallet que despliega (el valor real va en .env.local).
# Usar una wallet SOLO para deploy, nunca la del árbitro ni una con fondos.
# @sensitive @type=string(startsWith=0x, isLength=66)
DEPLOYER_PRIVATE_KEY=

# Dirección del árbitro (en producción: un multisig Safe)
# @type=string(startsWith=0x, isLength=42)
ARBITER_ADDRESS=

# Llave del árbitro SOLO para DeployLocal en Anvil (cuenta 1 de Anvil). Nunca una llave real.
# @sensitive @type=string(startsWith=0x, isLength=66)
ARBITER_KEY=

# API key de Arbiscan para verificar el contrato (el valor real va en .env.local)
# @sensitive @type=string
ARBISCAN_API_KEY=

# Dirección de la wallet que firma las aprobaciones/cancelaciones del backend (EIP-712)
# @type=string(startsWith=0x, isLength=42)
VOUCHER_SIGNER_ADDRESS=

# Llave privada del signer. SOLO la lee el servidor; en producción va en un secret manager.
# Distinta a la del deployer y a la del árbitro.
# @sensitive @type=string(startsWith=0x, isLength=66)
VOUCHER_SIGNER_KEY=


# @type=string(startsWith=0x, isLength=42)
QUEST_ESCROW_ANVIL=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# @type=string(startsWith=0x, isLength=42)
QUEST_ESCROW_SEPOLIA=0xC0F2620BD7811881cD9A3C3aFfDDD13A88E57De2

# @type=number
QUEST_ESCROW_SEPOLIA_BLOCK=12102825

# ---------------------------------------------------------------
# Storage S3-compatible (evidencias) — MinIO local, R2/Railway en prod
# ---------------------------------------------------------------

# Endpoint S3 (local: MinIO. Prod: https://<account>.r2.cloudflarestorage.com)
# @required @type=url
S3_ENDPOINT=http://localhost:9000

# Región (MinIO: us-east-1. R2: auto)
# @required @type=string
S3_REGION=us-east-1

# Nombre del bucket privado de evidencias
# @required @type=string
S3_BUCKET=perkify-evidence

# Access key (el valor real va en .env.local)
# @required @type=string
S3_ACCESS_KEY_ID=

# Secret key (el valor real va en .env.local)
# @required @sensitive @type=string
S3_SECRET_ACCESS_KEY=

# true en MinIO, false en R2
# @type=boolean
S3_FORCE_PATH_STYLE=true